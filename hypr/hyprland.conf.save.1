# You can split this configuration into multiple files
# Create your files separately and then link them to this file like this:
# source = ~/.config/hypr/myColors.conf

source = ~/.config/hypr/configs/lookandfeel.conf
source = ~/.config/hypr/configs/inputs.conf

################
### MONITORS ###
################

# See https://wiki.hyprland.org/Configuring/Monitors/
monitor = eDP-1, preferred, auto, 1
monitor = HDMI-A-2, 1920x1080@120, auto, 0.5, mirror, eDP-1
monitor = DP-1, 2560x1440@120, 0x0, 1, bitdepth, 10
monitor = DP-2, 1920x1080@100, 0x0, 1
monitor = DP-3, 1920x1080@60, auto, 0.5, mirror, eDP-1
monitor = DP-4, 1920x1080@60, 0x0, 1
###################
### MY PROGRAMS ###
###################

# See https://wiki.hyprland.org/Configuring/Keywords/

# Set programs that you use
$terminal = kitty
$fileManager = thunar
$menu = wofi --show drun


#################
### AUTOSTART ###
#################

# Autostart necessary processes (like notifications daemons, status bars, etc.)
# Or execute your favorite apps at launch like this:

# exec-once = $terminal
# exec-once = nm-applet &
exec-once = waybar & hypridle & swaync 
exec-once = kdeconnect-indicator & nm-applet &
exec-once = awww-daemon & aww img /home/Eoin/.config/hypr/wallpapers/wallpaper.jpg


#############################
### ENVIRONMENT VARIABLES ###
#############################

# See https://wiki.hyprland.org/Configuring/Environment-variables/
xwayland {
  force_zero_scaling = true
}
env = GTK_THEME,Nordic
env = XCURSOR_THEME,breeze_cursors
env = XCURSOR_SIZE,24
env = dpi,120
env = HYPRCURSOR_THEME,breeze_cursors
env = HYPRCURSOR_SIZE,24


##############################
### WINDOWS AND WORKSPACES ###
##############################

windowrule {
    # Ignore maximize requests from all apps. You'll probably like this.
    name = suppress-maximize-events
    match:class = .*

    suppress_event = maximize
}

